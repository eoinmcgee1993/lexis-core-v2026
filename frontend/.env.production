# Committed intentionally — none of these are secrets. VITE_SUPABASE_ANON_KEY
# is a publishable key by design (Supabase's anon key is meant to ship in the
# client bundle; RLS is the actual access boundary, not keeping this hidden),
# and the URL/backend origin are just public endpoints. Vite loads this file
# automatically on `vite build` (mode=production) — no Vercel dashboard env
# var configuration needed for the frontend.
VITE_BACKEND_URL=https://lexis-commerce.vercel.app
VITE_SUPABASE_URL=https://ucgoqgwopnxiktlxlyhc.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVjZ29xZ3dvcG54aWt0bHhseWhjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYwNDYwMzEsImV4cCI6MjEwMTYyMjAzMX0.mDQjhXQnGTDKO-bqrK5agKjgjSVRRdSotHBW2_jhZDA

# Photo avatar (frontend/public/avatar/lexis-tutor-photo.jpg) — takes
# priority over the 3D model below when set. See
# scripts/avatar/lexis-tutor-photo-notes.md for how it was generated and
# how to swap in a nicer/real-identity version later.
VITE_AVATAR_PHOTO_URL=/avatar/lexis-tutor-photo.jpg

# Simple procedural placeholder avatar (frontend/public/avatar/lexis-tutor.glb,
# generated by scripts/avatar/generate_avatar.py) — kept configured as a
# second-tier fallback if the photo ever fails to load (see TutorAvatar in
# LexisApp.jsx: photo -> 3D -> SVG). Swap for a real MetaPerson/Ready Player
# Me export by replacing that file, no code change needed as long as it
# exposes the same morph target names.
VITE_AVATAR_GLB_URL=/avatar/lexis-tutor.glb
