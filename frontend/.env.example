VITE_BACKEND_URL=http://localhost:3001

# Supabase (Project Settings → API) — anon/public key only, safe for the browser
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe recurring Price IDs (Dashboard → Product catalog → your product →
# pricing → copy the "price_..." ID, NOT the product ID). The /pricing page
# sends this to the backend, which creates a subscription-mode Checkout
# Session server-side — see backend/server.mjs's /api/stripe/checkout.
VITE_STRIPE_WEEKLY_PRICE_ID=price_YOUR_WEEKLY_PRICE_ID
VITE_STRIPE_MONTHLY_PRICE_ID=price_YOUR_MONTHLY_PRICE_ID
