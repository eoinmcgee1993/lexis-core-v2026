VITE_BACKEND_URL=http://localhost:3001

# Supabase (Project Settings → API) — anon/public key only, safe for the browser
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe Payment Links (Dashboard → Payment Links). Configure each link's
# metadata with tier=weekly / tier=monthly so the webhook can tell them apart,
# and require the buyer's email so the account can be matched and activated.
VITE_STRIPE_WEEKLY_LINK=https://buy.stripe.com/YOUR_STRIPE_WEEKLY_LINK
VITE_STRIPE_MONTHLY_LINK=https://buy.stripe.com/YOUR_STRIPE_MONTHLY_LINK
