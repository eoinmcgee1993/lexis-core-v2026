VITE_BACKEND_URL=http://localhost:3001

# Supabase (Project Settings → API) — anon/public key only, safe for the browser
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe Price IDs are not a frontend concern at all: the browser only ever
# sends which tier was picked (`planTier`), and the backend resolves that to
# a real Price (backend/app.mjs's STRIPE_PRICES, overridable with
# STRIPE_PRICE_WEEKLY_ONETIME / STRIPE_PRICE_MONTHLY_ONETIME). They are
# one-time prices — LEXIS sells passes, not subscriptions. See DEPLOY.md
# Step 2. This block used to say to edit a STRIPE_PRICES object in
# PricingPage.jsx; that object moved server-side on 21 Aug 2026 precisely
# because a client-supplied price id could be charged as-is.

# Optional avatar overrides, checked in this priority order — see
# TutorAvatar in frontend/src/pages/LexisApp.jsx: photo > 3D model > SVG
# placeholder. Both unset here; the app falls back to the SVG face locally.
# Production (.env.production) sets both, so a photo failure falls back to
# the 3D model before ever reaching SVG.
#
# Photo avatar (frontend/src/components/TutorAvatarPhoto.jsx) — a real
# portrait with an animated mouth-shadow overlay for lip-sync. No three.js,
# cheapest and best-looking tier. See
# scripts/avatar/lexis-tutor-photo-notes.md for provenance and how to
# upgrade to a true second "mouth open" photo later.
# VITE_AVATAR_PHOTO_URL=/avatar/lexis-tutor-photo.jpg
#
# 3D model (.glb) — never pulls the three.js/@react-three bundle in when
# unset. For a real character, export a .glb from MetaPerson Creator /
# Ready Player Me with ARKit or Oculus viseme blend shapes enabled.
# VITE_AVATAR_GLB_URL=/avatar/lexis-tutor.glb
