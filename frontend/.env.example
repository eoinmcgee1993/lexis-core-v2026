VITE_BACKEND_URL=http://localhost:3001

# Supabase (Project Settings → API) — anon/public key only, safe for the browser
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe recurring Price IDs are NOT set via env var — edit the
# STRIPE_PRICES object directly in frontend/src/pages/PricingPage.jsx.
# See DEPLOY.md Step 2.

# Optional: URL to a .glb avatar model to render as LEXIS's face instead of
# the built-in SVG placeholder. Unset here — the app falls back to the SVG
# face and never pulls the three.js/@react-three bundle in when this is
# empty. Production (.env.production) points this at the simple placeholder
# checked into frontend/public/avatar/ (see scripts/avatar/). For a real
# character, export a .glb from MetaPerson Creator / Ready Player Me with
# ARKit or Oculus viseme blend shapes enabled and point this at it instead.
# VITE_AVATAR_GLB_URL=/avatar/lexis-tutor.glb
