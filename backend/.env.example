# OpenAI
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
# Optional — defaults to gpt-realtime-2.1 (app.mjs's POST /api/session) if
# unset; that endpoint's own comment explains the latency win this model
# gets over the base gpt-realtime family. Set this to gpt-realtime here
# (or in Vercel's real env vars) to roll back instantly if 2.1 ever
# regresses quality in real use — no code change needed either way, this
# var is read first. Do NOT set this to an old dated preview snapshot
# like gpt-4o-realtime-preview-2024-12-17 — that model 404s on
# POST /v1/realtime/calls, the WebRTC gateway this app's live sessions
# actually use. This example once named that broken snapshot directly,
# which meant copying this file verbatim into a real .env silently
# reintroduced the exact 404 it was already fixed once for.
OPENAI_MODEL=gpt-realtime-2.1
# Optional — powers /api/translate (live-conversation subtitles) and
# /api/feedback (post-session scoring). Defaults to gpt-4o-mini if unset.
OPENAI_TEXT_MODEL=gpt-4o-mini

# LEXIS
LEXIS_SALT=lexis_thai_beta_2026_salt

# Supabase (Project Settings → API)
# NOTE: SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — server-side only, never ship it to the frontend.
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe — all four required; the server refuses to boot without them.
# STRIPE_SECRET_KEY: Developers → API keys
# STRIPE_WEBHOOK_SECRET: Developers → Webhooks → your endpoint → Signing secret
STRIPE_SECRET_KEY=sk_live_or_sk_test_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_ENDPOINT_SIGNING_SECRET

# CORS — also doubles as the whitelist for Stripe Checkout success/cancel
# redirects: the request's Origin header is used when it's in this list.
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Server
PORT=3001
