# OpenAI
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
# Optional — defaults to gpt-realtime-2.1 (app.mjs's POST /api/session) if
# unset; that endpoint's own comment explains the latency win this model
# gets over the base gpt-realtime family. Set this to gpt-realtime here
# (or in Vercel's real env vars) to roll back instantly if 2.1 ever
# regresses quality in real use — no code change needed either way, this
# var is read first. Do NOT set this to an old dated preview snapshot
# like gpt-4o-realtime-preview-2024-12-17 — that model 404s on
# POST /v1/realtime/calls, the WebRTC gateway this app's live sessions
# actually use. This example once named that broken snapshot directly,
# which meant copying this file verbatim into a real .env silently
# reintroduced the exact 404 it was already fixed once for.
OPENAI_MODEL=gpt-realtime-2.1
# Optional — powers /api/translate (live-conversation subtitles) and
# /api/feedback (post-session scoring). Defaults to gpt-4o-mini if unset.
OPENAI_TEXT_MODEL=gpt-4o-mini

# Supabase (Project Settings → API)
# NOTE: SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — server-side only, never ship it to the frontend.
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe — all four required; the server refuses to boot without them.
# STRIPE_SECRET_KEY: Developers → API keys
# STRIPE_WEBHOOK_SECRET: Developers → Webhooks → your endpoint → Signing secret
STRIPE_SECRET_KEY=sk_live_or_sk_test_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_ENDPOINT_SIGNING_SECRET

# CORS — also doubles as the whitelist for Stripe Checkout success/cancel
# redirects: the request's Origin header is used when it's in this list.
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Server
PORT=3001

# Higgsfield — text-to-video at /studio (backend/app.mjs, "HIGGSFIELD
# GENERATION"). Optional: with these unset, /api/generations* answers 503
# and nothing else in the app is affected.
#
# HF_API_KEY_ID / HF_API_KEY_SECRET: console.higgsfield.ai → API keys. Sent
# only from this server as "Authorization: Key <id>:<secret>", only to
# api.higgsfield.ai. Never put them in frontend/.env* — every VITE_ variable
# ships to the browser. Use separate keys for development and production.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Who may generate. Each render is billed to the Higgsfield account and no
# learner payment covers it, so this FAILS CLOSED: empty means nobody.
# Comma-separated, case-insensitive, matched against the Supabase login email.
HIGGSFIELD_ALLOWED_EMAILS=
# Optional. Billable renders per user per rolling 24h (default 5), and how
# long an unfinished render may hold the user's one active slot (default 30).
HIGGSFIELD_DAILY_LIMIT=5
HIGGSFIELD_TIMEOUT_MINUTES=30
# Optional webhooks. Set BOTH to turn them on; with either unset the app
# polls, which always works. BASE_URL is this backend's public HTTPS origin
# (e.g. https://lexis-commerce.vercel.app). SECRET is any random string of
# 24+ characters (e.g. `openssl rand -hex 32`); it rides in the webhook URL
# because Higgsfield does not sign deliveries, and every delivery is
# re-checked against the status API before anything is written.
HIGGSFIELD_WEBHOOK_BASE_URL=
HIGGSFIELD_WEBHOOK_SECRET=
