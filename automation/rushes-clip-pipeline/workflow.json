        "options": {}
      },
      "id": "dde6ccc2-9f8b-45e7-b676-2fe12663afdf",
      "name": "Resend: Send QC Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2160,
        180
